# MoviePilot Windows 便携版默认配置
#
# 本文件在首次安装时写入 <安装目录>\config\app.env，升级不会覆盖。
# 其余配置项请在 WEB 界面「设定」中修改，或参考上游文档：
# https://wiki.movie-pilot.org
#
# 注意：改动 PORT / NGINX_PORT 后，需同步修改 Nginx\conf\nginx.conf 中的
# upstream backend_api 与 listen，两处不一致会导致前端 502。

# 后端 API 监听端口
PORT=3111

# 前端（nginx）监听端口，浏览器访问 http://127.0.0.1:3333
NGINX_PORT=3333

# 仅监听本机。需要局域网访问时改为 0.0.0.0
HOST=127.0.0.1

# 时区
TZ=Asia/Shanghai

# 站点资源包（站点索引、认证等）自动更新。
# 便携版的认证组件随安装包分发，在线更新会与安装包版本冲突，故默认关闭。
AUTO_UPDATE_RESOURCE=false

# 自动升级方式。便携版通过重新运行安装包升级，故关闭内置升级。
MOVIEPILOT_AUTO_UPDATE=false
